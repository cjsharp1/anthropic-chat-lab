# ---------------------------------------------------------------------------
# Template for the environment file.
#
# This file IS committed and holds no secrets. Copy it to .env if you want
# one — .env is git-ignored, so anything you put there stays on your machine.
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
#
# You do NOT need this file to run the app. Start the server, open the page,
# and paste your key into Settings — it is held in the server's memory and
# never written to disk. The only thing a .env buys you is not retyping the
# key after a restart.
# ---------------------------------------------------------------------------

# Your Anthropic API key. Starts with "sk-ant-".
#
# Optional. When set, it is loaded at startup as the initial key, and the
# Settings dialog shows it as coming from .env. Saving a key in Settings
# overrides it for that session; clearing one falls back to this value.
#
# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Port the local server listens on. Change it if 3000 is already in use.
PORT=3000
