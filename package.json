{
  "name": "anthropic-chat-lab",
  "version": "1.0.0",
  "description": "A teaching app for the Anthropic certifications: a chat client over the Claude API with a live activity log, example tools, and seven switchable orchestration patterns.",
  "main": "server/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc && tsc -p tsconfig.client.json && tsx scripts/copy-data.ts",
    "build:client": "tsc -p tsconfig.client.json",
    "watch:client": "tsc -p tsconfig.client.json --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "check-env": "tsx scripts/check-env.ts",
    "hello": "tsx scripts/hello-claude.ts",
    "try-notes": "tsx scripts/try-notes.ts",
    "try-flaky": "tsx scripts/try-flaky.ts",
    "try-effort": "tsx scripts/try-effort.ts",
    "audit-comments": "tsx scripts/audit-comments.ts"
  },
  "keywords": [
    "anthropic",
    "claude",
    "training"
  ],
  "author": "Chris Sharp",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
